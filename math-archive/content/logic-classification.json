{
  "groups": {
    "density-area": {
      "title": "확률밀도 아래 넓이와 누적확률 비교하기",
      "description": "확률을 도형의 넓이로 읽고, 전체 넓이와 구간별 누적확률에서 높이와 경계를 결정한다."
    },
    "continuous-branches": {
      "title": "연속성을 지키며 대수식의 가지 고르기",
      "description": "함숫값이 만족하는 식을 인수분해하고, 가지가 만나는 점과 값의 범위로 연속인 함수를 결정한다."
    },
    "absolute-root-pairing": {
      "title": "절댓값 곱에서 단순근을 짝지어 없애기",
      "description": "절댓값이 단순근에서 만드는 꼭짓점을 없애도록 원래 영점과 이동·반사된 영점을 겹친다."
    },
    "level-set-symmetry": {
      "title": "같은 높이의 모든 교점에 대칭 조건 적용하기",
      "description": "한 교점에서 끝내지 않고 같은 함숫값을 갖는 입력 전체를 주기와 반사로 만들고 다른 함수와 대조한다."
    },
    "moments": {
      "title": "분포를 나열하지 않고 평균·분산으로 계산하기",
      "description": "일차변환과 독립인 합의 평균·분산, 또는 평균에서의 거리 제곱을 이용해 필요한 기댓값을 구한다."
    },
    "graph-order": {
      "title": "간단한 입력의 높이 비교로 교점 범위 정하기",
      "description": "교점 자체를 풀지 않고 양끝의 함수값을 비교해 좌표를 제한한다. 교점에서 성립하는 두 식을 함께 써 높이의 관계를 구한다."
    }
  },
